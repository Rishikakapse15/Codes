class Solution {
    public int smallestDivisor(int[] nums, int threshold) {
        int low = 1;
        int high = 0;
        
        // The upper bound is the largest element in the array
        for (int num : nums) {
            high = Math.max(high, num);
        }
        
        // Binary search for the smallest valid divisor
        while (low < high) {
            int mid = low + (high - low) / 2;
            
            if (getDivisionSum(nums, mid) <= threshold) {
                high = mid; // Try to find a smaller divisor
            } else {
                low = mid + 1; // Divisor is too small, increase it
            }
        }
        
        return low;
    }
    
    // Helper function to calculate the ceiling division sum
    private int getDivisionSum(int[] nums, int divisor) {
        int sum = 0;
        for (int num : nums) {
            // Integer trick for Math.ceil(num / divisor)
            sum += (num + divisor - 1) / divisor;
        }
        return sum;
    }
}
