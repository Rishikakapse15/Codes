class Solution {
    public int zigZagArrays(int n, int l, int r) {
        int k = r - l + 1;
        long MOD = 1_000_000_007;

        // Base Case: If the array has only 1 element, any element in the range is valid.
        if (n == 1) {
            return k;
        }

        // dp0[v] stores count of arrays ending at value 'v' with an UP step
        // dp1[v] stores count of arrays ending at value 'v' with a DOWN step
        long[] dp0 = new long[k + 1];
        long[] dp1 = new long[k + 1];

        // Base Case for length 2:
        for (int v = 1; v <= k; v++) {
            dp0[v] = v - 1; // number of elements strictly smaller than v
            dp1[v] = k - v; // number of elements strictly greater than v
        }

        // Transition for lengths from 3 to n
        for (int i = 3; i <= n; i++) {
            long[] next_dp0 = new long[k + 1];
            long[] next_dp1 = new long[k + 1];

            // For an UP step ending at v, the previous step must be a DOWN step ending at u < v
            long currentSumDp1 = 0;
            for (int v = 1; v <= k; v++) {
                next_dp0[v] = currentSumDp1;
                currentSumDp1 = (currentSumDp1 + dp1[v]) % MOD;
            }

            // For a DOWN step ending at v, the previous step must be an UP step ending at u > v
            long currentSumDp0 = 0;
            for (int v = k; v >= 1; v--) {
                next_dp1[v] = currentSumDp0;
                currentSumDp0 = (currentSumDp0 + dp0[v]) % MOD;
            }

            dp0 = next_dp0;
            dp1 = next_dp1;
        }

        // Sum up all valid variations for the final length n
        long totalWays = 0;
        for (int v = 1; v <= k; v++) {
            totalWays = (totalWays + dp0[v] + dp1[v]) % MOD;
        }

        return (int) totalWays;
    }
}
