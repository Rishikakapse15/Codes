class Solution {
    public int maxValue(int[] arr) {
        // code here
         int n=arr.length;
         if(n==1) return arr[0];
         int[]dp1=new int[n];
         int[]dp2=new int[n];
         Arrays.fill(dp1,-1);
         Arrays.fill(dp2,-1);
         int cas1=loot(arr,0,n-2,dp1);//exclude last house
         int cas2 =loot(arr,1,n-1,dp2);//exclude 1st house
         return Math.max(cas1,cas2);
        
    }
    public int loot(int arr[], int i, int end, int[] dp) {
    if (i > end) return 0;
    if (dp[i] != -1) return dp[i];

    int pick = arr[i] + loot(arr, i + 2, end, dp);
    int skip = loot(arr, i + 1, end, dp);

    return dp[i] = Math.max(pick, skip);
}

}
