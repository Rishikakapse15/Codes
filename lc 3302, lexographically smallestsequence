class Solution {
    public int[] validSequence(String word1, String word2) {

        int n = word1.length();
        int m = word2.length();

        // suf[i] = how many characters of word2
        // can be matched exactly from word1[i...]
        int[] suf = new int[n + 1];

        int j = m - 1;

        for (int i = n - 1; i >= 0; i--) {

            suf[i] = suf[i + 1];

            if (j >= 0 && word1.charAt(i) == word2.charAt(j)) {
                suf[i]++;
                j--;
            }
        }

        int[] ans = new int[m];

        int i = 0;
        j = 0;
        boolean mismatchUsed = false;

        while (i < n && j < m) {

            // Case 1: characters match
            if (word1.charAt(i) == word2.charAt(j)) {

                ans[j] = i;
                j++;
                i++;

            }

            // Case 2: characters don't match
            else if (!mismatchUsed && suf[i + 1] >= m - j - 1) {

                // Use our one allowed mismatch
                ans[j] = i;
                j++;
                mismatchUsed = true;
                i++;

            }

            // Don't use this index
            else {
                i++;
            }
        }

        if (j != m) {
            return new int[0];
        }

        return ans;
    }
}
